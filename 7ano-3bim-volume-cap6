<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Oficina do Volume — Aula Interativa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --grass-dark:#2D5F3E;
    --grass:#7CB342;
    --grass-light:#9CCC5C;
    --dirt:#8B5A2B;
    --dirt-dark:#5C3A1E;
    --stone:#6B6B6B;
    --stone-dark:#3E3E3E;
    --sky:#6EC6E8;
    --sky-deep:#3A9BC1;
    --sand:#F5E6C8;
    --gold:#E8B93B;
    --white:#FFFFFF;
    --ink:#2A2A2A;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Nunito',sans-serif;
    background:linear-gradient(180deg,#DCEEF7 0%, var(--sand) 22%, var(--sand) 100%);
    color:var(--ink);
    min-height:100vh;
    position:relative;
    overflow-x:hidden;
    font-size:20px;
    line-height:1.5;
  }
  h1,h2,h3{font-family:'Baloo 2',cursive; margin:0;}
  .mono{font-family:'JetBrains Mono',monospace;}

  /* floating symbols background */
  .floaters{position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden;}
  .floaters span{
    position:absolute; font-family:'JetBrains Mono',monospace; font-weight:700;
    color:rgba(45,95,62,0.10); animation:drift 22s linear infinite;
  }
  @keyframes drift{
    0%{transform:translateY(110vh) rotate(0deg);}
    100%{transform:translateY(-15vh) rotate(25deg);}
  }

  .wrap{position:relative; z-index:1; max-width:1180px; margin:0 auto; padding:0 28px 80px;}

  /* header */
  header{
    display:flex; align-items:center; justify-content:space-between;
    padding:26px 28px; position:relative; z-index:2;
  }
  .brand{display:flex; align-items:center; gap:14px;}
  .brand .block-icon{width:44px; height:44px; background:linear-gradient(135deg,var(--grass-light),var(--grass-dark)); border-radius:8px; box-shadow: inset -6px -6px 0 rgba(0,0,0,0.15), inset 6px 6px 0 rgba(255,255,255,0.2);}
  .brand h1{font-size:1.5rem; color:var(--grass-dark);}
  .brand p{margin:2px 0 0; font-size:0.85rem; color:var(--stone-dark); font-weight:600;}

  #animalToggle{
    background:var(--white); border:3px solid var(--sky-deep); color:var(--sky-deep);
    font-family:'Nunito',sans-serif; font-weight:800; font-size:0.85rem;
    padding:10px 16px; border-radius:999px; cursor:pointer;
    display:flex; align-items:center; gap:8px;
    transition:transform .15s ease, background .2s ease;
  }
  #animalToggle:hover{transform:scale(1.04);}
  #animalToggle.on{background:var(--sky-deep); color:var(--white);}

  /* HERO / build zone */
  .hero{
    display:grid; grid-template-columns: 1.05fr 1fr; gap:40px; align-items:center;
    background:var(--white); border-radius:28px; padding:36px; margin-top:8px;
    box-shadow:0 10px 0 var(--stone); border:3px solid var(--stone-dark);
  }
  .hero h2{font-size:2.3rem; color:var(--dirt-dark); line-height:1.15;}
  .hero .lead{margin-top:14px; font-size:1.05rem; color:var(--stone-dark); font-weight:600;}
  .buildzone{
    background:linear-gradient(180deg,#CDEBFA,#EAF6FC);
    border-radius:20px; border:3px dashed var(--sky-deep);
    padding:24px; text-align:center; position:relative;
  }
  #isoScene{
    height:250px; perspective:1200px; perspective-origin:50% 20%;
    display:flex; align-items:center; justify-content:center; margin-bottom:6px;
  }
  #isoWorld{
    position:relative; transform-style:preserve-3d;
    transform: rotateX(-32deg) rotateY(-38deg);
  }
  .cube3d{
    position:absolute; top:0; left:0; width:var(--u); height:var(--u);
    transform-style:preserve-3d; animation:pop3d .22s ease;
  }
  @keyframes pop3d{ from{transform:scale(0.3); opacity:0;} to{transform:scale(1); opacity:1;} }
  .face{ position:absolute; top:0; left:0; width:var(--u); height:var(--u); border:1px solid rgba(0,0,0,0.15); }
  .face.top{ background:var(--grass-light); transform:rotateX(90deg) translateZ(calc(var(--u)/2)); }
  .face.front{ background:var(--grass); transform:translateZ(calc(var(--u)/2)); }
  .face.side{ background:var(--grass-dark); transform:rotateY(90deg) translateZ(calc(var(--u)/2)); }
  body.animal-mode .face.top{ background:#FFE2B3; }
  body.animal-mode .face.front{ background:#FFC168; }
  body.animal-mode .face.side{ background:#E8952E; }

  .dimControls{display:flex; gap:18px; justify-content:center; flex-wrap:wrap; margin-top:10px;}
  .dimGroup{background:var(--white); border:2px solid var(--stone); border-radius:12px; padding:8px 12px; text-align:center;}
  .dimGroup .dimLabel{font-family:'JetBrains Mono',monospace; font-weight:700; font-size:0.85rem; color:var(--stone-dark); display:block; margin-bottom:4px;}
  .dimGroup .dimRow{display:flex; align-items:center; gap:8px;}
  .dimBtn{
    width:30px; height:30px; border-radius:8px; border:none; cursor:pointer;
    font-family:'Baloo 2',cursive; font-weight:800; font-size:1rem; color:var(--white);
    background:var(--grass-dark); box-shadow:0 3px 0 rgba(0,0,0,0.25);
  }
  .dimBtn.minus{background:var(--dirt);}
  .dimVal{font-family:'JetBrains Mono',monospace; font-weight:700; min-width:18px; display:inline-block;}
  .buildControls{margin-top:18px; display:flex; gap:10px; justify-content:center; flex-wrap:wrap;}
  .btn{
    font-family:'Baloo 2',cursive; font-size:1rem; font-weight:700; cursor:pointer;
    border:none; border-radius:12px; padding:10px 18px; color:var(--white);
    box-shadow:0 4px 0 rgba(0,0,0,0.25); transition:transform .1s ease;
  }
  .btn:active{transform:translateY(3px); box-shadow:0 1px 0 rgba(0,0,0,0.25);}
  .btn-grass{background:var(--grass-dark);}
  .btn-dirt{background:var(--dirt);}
  .btn-sky{background:var(--sky-deep);}
  .btn-gold{background:var(--gold); color:var(--dirt-dark);}
  #volumeReadout{
    margin-top:16px; font-family:'JetBrains Mono',monospace; font-size:1.2rem; font-weight:700;
    color:var(--grass-dark); background:var(--white); display:inline-block; padding:8px 18px; border-radius:10px;
    border:2px solid var(--grass-dark);
  }

  /* sections */
  section{margin-top:46px;}
  .section-title{display:flex; align-items:center; gap:14px; margin-bottom:22px;}
  .section-badge{
    width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center;
    font-family:'Baloo 2',cursive; font-weight:800; font-size:1.3rem; color:var(--white); flex-shrink:0;
    box-shadow:0 4px 0 rgba(0,0,0,0.2);
  }
  .section-title h2{font-size:1.7rem; color:var(--stone-dark);}

  .card{
    background:var(--white); border-radius:22px; padding:30px; border:3px solid var(--stone-dark);
    box-shadow:0 8px 0 var(--stone);
  }

  .formula-box{
    background:linear-gradient(135deg,var(--dirt),var(--dirt-dark)); color:var(--sand);
    border-radius:18px; padding:22px 28px; text-align:center; margin:20px 0;
    border:3px solid var(--dirt-dark);
  }
  .formula-box .tag{font-size:0.8rem; letter-spacing:1px; text-transform:uppercase; color:var(--gold); font-weight:800;}
  .formula-box .formula{font-family:'JetBrains Mono',monospace; font-size:2rem; font-weight:700; margin-top:8px;}

  .example-grid{display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:20px;}
  .tank{
    background:linear-gradient(180deg,#BFE7F4,#8FD3EA); border-radius:16px; border:3px solid var(--sky-deep);
    padding:20px; text-align:center; font-weight:700; color:var(--sky-deep);
  }
  .tank .dims{font-family:'JetBrains Mono',monospace; font-size:1.05rem; margin-top:8px; color:var(--stone-dark);}

  /* staircase conversion */
  .stairwrap{display:flex; align-items:flex-end; justify-content:center; gap:0; margin:30px 0; flex-wrap:wrap;}
  .step{
    background:var(--grass); color:var(--white); font-family:'JetBrains Mono',monospace; font-weight:700;
    padding:18px 22px; text-align:center; border:3px solid var(--grass-dark); position:relative;
  }
  .step:nth-child(1){border-radius:14px 0 0 14px; background:var(--grass-dark);}
  .step:nth-child(3){background:var(--sky-deep); border-color:var(--sky-deep);}
  .step:nth-child(5){border-radius:0 14px 14px 0; background:var(--gold); color:var(--dirt-dark); border-color:var(--gold);}
  .arrow-x1000{font-family:'Baloo 2',cursive; font-weight:800; color:var(--dirt-dark); padding:0 12px; font-size:1rem;}

  .converter{background:var(--sand); border-radius:16px; padding:20px; margin-top:10px; border:2px solid var(--dirt);}
  .converter label{font-weight:700; color:var(--dirt-dark);}
  .converter input{
    font-family:'JetBrains Mono',monospace; font-size:1.1rem; padding:8px 12px; border-radius:8px;
    border:2px solid var(--stone); width:110px; margin:0 10px;
  }
  .converter select{font-family:'Nunito',sans-serif; font-weight:700; padding:8px; border-radius:8px; border:2px solid var(--stone);}
  #convResult{font-family:'JetBrains Mono',monospace; font-weight:700; color:var(--grass-dark); margin-top:12px; font-size:1.15rem;}

  /* quiz */
  .quiz-q{margin-bottom:26px;}
  .quiz-q p.question{font-weight:800; font-size:1.1rem; color:var(--stone-dark);}
  .options{display:flex; flex-direction:column; gap:10px; margin-top:10px;}
  .option{
    background:var(--white); border:2px solid var(--stone); border-radius:12px; padding:12px 16px;
    cursor:pointer; font-weight:700; transition:all .15s ease;
  }
  .option:hover{border-color:var(--sky-deep); background:#F0FAFE;}
  .option.correct{background:#DDF3D2; border-color:var(--grass-dark); color:var(--grass-dark);}
  .option.wrong{background:#FADADA; border-color:#C0392B; color:#C0392B;}
  .feedback{margin-top:10px; font-weight:700; padding:10px 14px; border-radius:10px; display:none;}
  .feedback.show{display:block;}
  .feedback.good{background:#DDF3D2; color:var(--grass-dark);}
  .feedback.bad{background:#FADADA; color:#C0392B;}

  /* exercises */
  .ex-list{display:flex; flex-direction:column; gap:20px;}
  .ex-item{background:var(--white); border-radius:16px; padding:20px 24px; border:2px solid var(--stone); position:relative;}
  .ex-num{
    position:absolute; top:-14px; left:-14px; width:38px; height:38px; border-radius:10px;
    background:var(--dirt); color:var(--white); font-family:'Baloo 2',cursive; font-weight:800;
    display:flex; align-items:center; justify-content:center; box-shadow:0 3px 0 var(--dirt-dark);
  }
  .ex-item p{margin:6px 0 0;}
  .answer{
    margin-top:10px; font-family:'JetBrains Mono',monospace; font-weight:700; color:var(--grass-dark);
    display:none; background:#F1F9EC; padding:8px 12px; border-radius:8px;
  }
  .answer.show{display:block;}
  #toggleAnswers{margin-bottom:18px;}

  footer{text-align:center; margin-top:60px; color:var(--stone-dark); font-weight:700; font-size:0.9rem;}

  /* Modo Animal overrides */
  body.animal-mode .cube{background:linear-gradient(145deg,#FFD79E,#F6A93E);}
  body.animal-mode .section-badge::after{content:" 🐾";}
  body.animal-mode .brand p::after{content:" · modo animal ativo";}

  @media (max-width:820px){
    .hero{grid-template-columns:1fr;}
    .example-grid{grid-template-columns:1fr;}
  }

  @media print{
    header, .hero, section:not(#exercicios), .floaters, #animalToggle, .buildControls{display:none !important;}
    body{background:#fff; font-size:14px;}
    #exercicios{margin-top:0;}
    .card, .ex-item{box-shadow:none; border:1px solid #999;}
    .answer{display:none !important;}
  }
</style>
</head>
<body>

<div class="floaters">
  <span style="left:5%; font-size:2.4rem; animation-duration:26s;">m³</span>
  <span style="left:18%; font-size:1.6rem; animation-delay:-6s;">×1000</span>
  <span style="left:32%; font-size:2rem; animation-delay:-14s;">dm³</span>
  <span style="left:48%; font-size:1.4rem; animation-delay:-3s;">a·b·h</span>
  <span style="left:62%; font-size:2.2rem; animation-delay:-10s;">cm³</span>
  <span style="left:76%; font-size:1.7rem; animation-delay:-18s;">V</span>
  <span style="left:88%; font-size:2rem; animation-delay:-8s;">∛</span>
  <span style="left:40%; font-size:1.5rem; animation-delay:-20s;">cm³</span>
</div>

<header>
  <div class="brand">
    <div class="block-icon"></div>
    <div>
      <h1>Oficina do Volume</h1>
      <p>aulasdarafa.com.br · 7º ano · Bimestre 3</p>
    </div>
  </div>
  <button id="animalToggle" onclick="toggleAnimal()">🐨 Modo Animal</button>
</header>

<div class="wrap">

  <!-- HERO / BUILD ZONE -->
  <div class="hero">
    <div>
      <h2>Quantos blocos cabem aqui dentro?</h2>
      <p class="lead">Toda vez que você empilha peças iguais, sem deixar buraco e sem sobrepor, está calculando um <strong>volume</strong>. Cada bloquinho é uma unidade. Contar os bloquinhos é medir o espaço.</p>
      <p class="lead">Ao lado tem um bloco em 3D de verdade. Use os botões para mexer separadamente no comprimento, na largura e na altura — repare que o bloco cresce pra três direções diferentes, não só pra frente. O contador mostra, ao vivo, quantos cubinhos você já usou: esse número É o volume da construção.</p>
    </div>
    <div class="buildzone">
      <div id="isoScene"><div id="isoWorld"></div></div>
      <div class="dimControls">
        <div class="dimGroup">
          <span class="dimLabel">comprimento (a)</span>
          <div class="dimRow">
            <button class="dimBtn minus" onclick="changeDim('a',-1)">−</button>
            <span class="dimVal" id="valA">2</span>
            <button class="dimBtn" onclick="changeDim('a',1)">+</button>
          </div>
        </div>
        <div class="dimGroup">
          <span class="dimLabel">largura (b)</span>
          <div class="dimRow">
            <button class="dimBtn minus" onclick="changeDim('b',-1)">−</button>
            <span class="dimVal" id="valB">2</span>
            <button class="dimBtn" onclick="changeDim('b',1)">+</button>
          </div>
        </div>
        <div class="dimGroup">
          <span class="dimLabel">altura (h)</span>
          <div class="dimRow">
            <button class="dimBtn minus" onclick="changeDim('h',-1)">−</button>
            <span class="dimVal" id="valH">2</span>
            <button class="dimBtn" onclick="changeDim('h',1)">+</button>
          </div>
        </div>
      </div>
      <div class="buildControls">
        <button class="btn btn-sky" onclick="resetStage()">Zerar</button>
      </div>
      <div id="volumeReadout">V = 2 · 2 · 2 = 8 unidades cúbicas</div>
    </div>
  </div>

  <!-- SECTION: FORMULA -->
  <section>
    <div class="section-title">
      <div class="section-badge" style="background:var(--grass-dark);">1</div>
      <h2>A receita para não precisar contar bloco por bloco</h2>
    </div>
    <div class="card">
      <p>Contar cubinho por cubinho funciona, mas é lento. Repare que uma construção em bloco retangular sempre tem <strong>camadas iguais</strong>: se você sabe quantos cubos cabem numa camada (comprimento × largura) e quantas camadas existem (altura), você descobre o total sem contar nada.</p>
      <div class="formula-box">
        <div class="tag">Receita do volume</div>
        <div class="formula">V = a · b · h</div>
      </div>
      <p>Vamos testar num <strong>aquário</strong> retangular que uma turma quer montar para observar caramujos:</p>
      <div class="example-grid">
        <div class="tank">
          🐟 Aquário retangular
          <div class="dims">comprimento a = 5 dm<br>largura b = 3 dm<br>altura h = 4 dm</div>
        </div>
        <div class="tank" style="background:linear-gradient(180deg,#FCEFC6,#F6DD8E); border-color:var(--gold); color:var(--dirt-dark);">
          Cálculo
          <div class="dims mono">V = 5 · 3 · 4<br>V = 60 dm³</div>
          <p style="font-size:0.95rem; margin-top:8px;">60 dm³ de água cabem nesse aquário — sem contar litro nenhum ainda!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION: UNITS / CONVERSION -->
  <section>
    <div class="section-title">
      <div class="section-badge" style="background:var(--sky-deep);">2</div>
      <h2>Trocando de "tamanho de bloco": as unidades cúbicas</h2>
    </div>
    <div class="card">
      <p>Existem cubos de tamanhos diferentes usados como unidade: o <strong>cm³</strong> (aresta de 1 cm), o <strong>dm³</strong> (aresta de 1 dm) e o <strong>m³</strong> (aresta de 1 m). Subir de um nível de unidade para o de baixo é como trocar 1 bloco grande por 1000 blocos pequenos que cabem exatamente dentro dele.</p>
      <div class="stairwrap">
        <div class="step">1 m³</div>
        <div class="arrow-x1000">× 1000 →</div>
        <div class="step">1 dm³</div>
        <div class="arrow-x1000">× 1000 →</div>
        <div class="step">1 000 000 cm³</div>
      </div>
      <p style="text-align:center; font-size:0.95rem; color:var(--stone-dark);">(cada "degrau" para baixo multiplica por 1000 — cada "degrau" para cima divide por 1000)</p>

      <div class="converter">
        <label>Converter:</label>
        <input type="number" id="convValue" value="2.5" step="any">
        <select id="convFrom">
          <option value="m3">m³</option>
          <option value="dm3" selected>dm³</option>
          <option value="cm3">cm³</option>
        </select>
        →
        <select id="convTo">
          <option value="m3">m³</option>
          <option value="dm3">dm³</option>
          <option value="cm3" selected>cm³</option>
        </select>
        <button class="btn btn-gold" onclick="doConvert()" style="margin-left:10px;">Converter</button>
        <div id="convResult"></div>
      </div>
    </div>
  </section>

  <!-- SECTION: QUICK QUIZ -->
  <section>
    <div class="section-title">
      <div class="section-badge" style="background:var(--dirt);">3</div>
      <h2>Verificação rápida</h2>
    </div>
    <div class="card">
      <div class="quiz-q" data-answer="b">
        <p class="question">1. Uma caixa organizadora tem 4 dm de comprimento, 2 dm de largura e 3 dm de altura. Qual é o seu volume?</p>
        <div class="options">
          <div class="option" data-opt="a">9 dm³</div>
          <div class="option" data-opt="b">24 dm³</div>
          <div class="option" data-opt="c">18 dm³</div>
        </div>
        <div class="feedback"></div>
      </div>
      <div class="quiz-q" data-answer="c">
        <p class="question">2. Sabendo que 1 dm³ = 1000 cm³, quanto vale 2,5 dm³ em cm³?</p>
        <div class="options">
          <div class="option" data-opt="a">250 cm³</div>
          <div class="option" data-opt="b">1 250 cm³</div>
          <div class="option" data-opt="c">2 500 cm³</div>
        </div>
        <div class="feedback"></div>
      </div>
      <div class="quiz-q" data-answer="a">
        <p class="question">3. Um cubo tem aresta de 1 dm. Quantos cubinhos de aresta 1 cm cabem dentro dele?</p>
        <div class="options">
          <div class="option" data-opt="a">1 000</div>
          <div class="option" data-opt="b">100</div>
          <div class="option" data-opt="c">10</div>
        </div>
        <div class="feedback"></div>
      </div>
    </div>
  </section>

  <!-- SECTION: EXERCISES (printable) -->
  <section id="exercicios">
    <div class="section-title">
      <div class="section-badge" style="background:var(--gold); color:var(--dirt-dark);">4</div>
      <h2>Agora é sua vez — exercícios</h2>
    </div>
    <button class="btn btn-sky" id="toggleAnswers" onclick="toggleAnswers()">Mostrar respostas (professor)</button>
    <div class="ex-list">

      <div class="ex-item">
        <div class="ex-num">1</div>
        <p><strong>Baú de brinquedos.</strong> Um baú retangular de madeira tem 7 dm de comprimento, 4 dm de largura e 3 dm de altura. Calcule o volume do baú.</p>
        <div class="answer">V = 7 · 4 · 3 = 84 dm³</div>
      </div>

      <div class="ex-item">
        <div class="ex-num">2</div>
        <p><strong>Aquário misterioso.</strong> Um aquário tem 60 cm de comprimento e 30 cm de largura. Sabendo que seu volume é 36 000 cm³, descubra a altura do aquário.</p>
        <div class="answer">36000 ÷ (60 · 30) = 36000 ÷ 1800 = altura de 20 cm</div>
      </div>

      <div class="ex-item">
        <div class="ex-num">3</div>
        <p><strong>Trocando de unidade.</strong> Converta: a) 4,2 dm³ em cm³  b) 3 500 cm³ em dm³  c) 0,08 m³ em dm³</p>
        <div class="answer">a) 4 200 cm³  b) 3,5 dm³  c) 80 dm³</div>
      </div>

      <div class="ex-item">
        <div class="ex-num">4</div>
        <p><strong>Dois tamanhos de bloco.</strong> Uma caixa organizadora tem volume de 96 unidades quando medida com um cubo pequeno A. Um cubo B tem 8 vezes o volume do cubo A. Quantos cubos B cabem (aproximadamente) na mesma caixa?</p>
        <div class="answer">96 ÷ 8 = 12 cubos B</div>
      </div>

      <div class="ex-item">
        <div class="ex-num">5</div>
        <p><strong>A caixa que cresceu.</strong> Uma caixa de sapatos teve comprimento, largura e altura todos dobrados. Quantas cópias da caixa original cabem dentro da caixa nova?</p>
        <div class="answer">2 × 2 × 2 = 8 cópias</div>
      </div>

      <div class="ex-item">
        <div class="ex-num">6</div>
        <p><strong>Desafio do cubo mágico.</strong> Um cubo tem volume de 64 dm³. Por tentativa, descubra a medida da aresta desse cubo (dica: você não precisa de raiz cúbica, só testar números naturais).</p>
        <div class="answer">4 · 4 · 4 = 64 → aresta = 4 dm</div>
      </div>

    </div>
  </section>

  <footer>
    Oficina do Volume · Rafaella · aulasdarafa.com.br
  </footer>
</div>

<script>
  const dims = {a:2, b:2, h:2};
  const U = 34; // unit cube edge in px
  const MIN = 1, MAX = 4;

  function render(){
    const world = document.getElementById('isoWorld');
    world.innerHTML = '';
    world.style.setProperty('--u', U + 'px');
    world.style.width = U + 'px';
    world.style.height = U + 'px';

    // center the whole block in the scene
    const offsetX = (dims.a * U) / 2;
    const offsetY = (dims.h * U) / 2;
    const offsetZ = (dims.b * U) / 2;

    for(let k=0; k<dims.h; k++){       // altura (sobe)
      for(let j=0; j<dims.b; j++){     // largura (profundidade)
        for(let i=0; i<dims.a; i++){   // comprimento (direita)
          const cube = document.createElement('div');
          cube.className = 'cube3d';
          const x = i*U - offsetX;
          const y = -(k*U) + offsetY - U;
          const z = j*U - offsetZ;
          cube.style.setProperty('--u', U + 'px');
          cube.style.transform = `translate3d(${x}px, ${y}px, ${z}px)`;
          cube.innerHTML = '<div class="face top"></div><div class="face front"></div><div class="face side"></div>';
          world.appendChild(cube);
        }
      }
    }
    document.getElementById('valA').textContent = dims.a;
    document.getElementById('valB').textContent = dims.b;
    document.getElementById('valH').textContent = dims.h;
    const v = dims.a * dims.b * dims.h;
    document.getElementById('volumeReadout').textContent = 'V = ' + dims.a + ' · ' + dims.b + ' · ' + dims.h + ' = ' + v + ' unidades cúbicas';
  }
  function changeDim(key, delta){
    const next = dims[key] + delta;
    if(next < MIN || next > MAX) return;
    dims[key] = next;
    render();
  }
  function resetStage(){ dims.a=2; dims.b=2; dims.h=2; render(); }
  render();

  function toggleAnimal(){
    document.body.classList.toggle('animal-mode');
    const btn = document.getElementById('animalToggle');
    btn.classList.toggle('on');
  }

  // conversion tool
  const factors = {m3:1, dm3:1000, cm3:1000000};
  function doConvert(){
    const val = parseFloat(document.getElementById('convValue').value);
    const from = document.getElementById('convFrom').value;
    const to = document.getElementById('convTo').value;
    if(isNaN(val)){ document.getElementById('convResult').textContent='Digite um número válido.'; return; }
    const inM3 = val / factors[from];
    const result = inM3 * factors[to];
    const labels = {m3:'m³', dm3:'dm³', cm3:'cm³'};
    document.getElementById('convResult').textContent =
      val + ' ' + labels[from] + ' = ' + result.toLocaleString('pt-BR', {maximumFractionDigits:6}) + ' ' + labels[to];
  }

  // quiz logic
  document.querySelectorAll('.quiz-q').forEach(q=>{
    const correct = q.dataset.answer;
    const fb = q.querySelector('.feedback');
    q.querySelectorAll('.option').forEach(opt=>{
      opt.addEventListener('click', ()=>{
        q.querySelectorAll('.option').forEach(o=>o.classList.remove('correct','wrong'));
        if(opt.dataset.opt === correct){
          opt.classList.add('correct');
          fb.textContent = '✅ Isso mesmo! Muito bem.';
          fb.className = 'feedback show good';
        } else {
          opt.classList.add('wrong');
          q.querySelector('[data-opt="'+correct+'"]').classList.add('correct');
          fb.textContent = '❌ Quase — repare na unidade e na multiplicação antes de responder de novo.';
          fb.className = 'feedback show bad';
        }
      });
    });
  });

  // answer key toggle
  let answersOn = false;
  function toggleAnswers(){
    answersOn = !answersOn;
    document.querySelectorAll('.answer').forEach(a=>a.classList.toggle('show', answersOn));
    document.getElementById('toggleAnswers').textContent = answersOn ? 'Ocultar respostas' : 'Mostrar respostas (professor)';
  }
</script>

</body>
</html>
