<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Batata Quente da Regra de Três</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Patrick+Hand&display=swap">
<style>
/* Layout: lousa verde de sala de aula; problema no alto, 4 etapas em fila, controle da batata embaixo. Visual único (lousa), pensado para projetor. */
:root {
  --lousa: #1d3a31;
  --lousa-2: #24473c;
  --lousa-3: #2e574a;
  --giz: #f4f1e6;
  --giz-suave: #c9d3cb;
  --amarelo: #f6d04d;
  --rosa: #f29b9b;
  --verde-ok: #9fe0a8;
  --madeira: #6b4a2b;
  --f-mao: "Patrick Hand", "Comic Sans MS", "Segoe Print", cursive;
  --f-txt: "Atkinson Hyperlegible", "Segoe UI", system-ui, sans-serif;
  color-scheme: dark;
}
html, body { height: 100%; }
body {
  background: var(--lousa);
  color: var(--giz);
  font-family: var(--f-txt);
  font-size: clamp(16px, 1.15vw + 8px, 22px);
  line-height: 1.4;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 14px 20px;
  box-sizing: border-box;
  border-top: 10px solid var(--madeira);
  border-bottom: 10px solid var(--madeira);
}
* { box-sizing: border-box; }
.wrap { max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
h1, h2, h3 { font-family: var(--f-mao); font-weight: 400; margin: 0; text-wrap: balance; letter-spacing: 0.01em; }
button { font: inherit; cursor: pointer; }
button:focus-visible, select:focus-visible, input:focus-visible { outline: 3px solid var(--amarelo); outline-offset: 3px; }

/* ---------- barra do topo ---------- */
.topo { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
.topo h1 { font-size: clamp(28px, 2.6vw + 10px, 52px); line-height: 1; }
.topo h1 span { color: var(--amarelo); }
.placar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.estrelas { font-family: var(--f-mao); font-size: clamp(22px, 1.6vw + 10px, 38px); font-variant-numeric: tabular-nums; }
.estrelas b { color: var(--amarelo); font-weight: 400; }
.barra { width: clamp(140px, 18vw, 320px); height: 16px; border-radius: 99px; background: var(--lousa-3); overflow: hidden; border: 2px solid var(--giz-suave); }
.barra i { display: block; height: 100%; width: 0; background: var(--amarelo); transition: width .5s ease; }
.vs { color: var(--giz-suave); }
.estrelas b.bat { color: #d8ae6c; }
.btn-peq { background: transparent; color: var(--giz); border: 2px solid var(--giz-suave); border-radius: 10px; padding: 6px 12px; font-size: 0.85em; }
.btn-peq:hover { border-color: var(--giz); }

/* ---------- regra de ouro ---------- */
.regra { font-family: var(--f-mao); font-size: clamp(18px, 1vw + 10px, 28px); color: var(--giz-suave); border: 2px dashed var(--giz-suave); border-radius: 12px; padding: 6px 14px; }
.regra b { color: var(--amarelo); font-weight: 400; }

/* ---------- problema ---------- */
.problema { display: grid; grid-template-columns: auto 1fr; gap: 6px 20px; align-items: start; }
.num { font-family: var(--f-mao); font-size: clamp(44px, 4vw + 10px, 88px); line-height: .9; color: var(--amarelo); font-variant-numeric: tabular-nums; }
.enun { min-width: 0; }
.tag { display: inline-block; font-size: 0.7em; text-transform: uppercase; letter-spacing: 0.12em; color: var(--lousa); background: var(--giz-suave); border-radius: 6px; padding: 2px 8px; margin-bottom: 6px; font-weight: 700; }
.tag.quim { background: var(--rosa); }
.enun p { margin: 0; font-size: clamp(22px, 1.7vw + 10px, 40px); line-height: 1.3; }

/* ---------- etapas ---------- */
.etapas { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
@media (max-width: 900px) { .etapas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 480px) { .etapas { grid-template-columns: 1fr; } }
.etapa { background: var(--lousa-2); border: 2px solid transparent; border-radius: 14px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; min-width: 0; min-height: 170px; transition: border-color .2s, opacity .2s; }
.etapa.atual { border-color: var(--amarelo); }
.etapa.futura { opacity: .45; }
.etapa h3 { font-size: clamp(20px, 1vw + 12px, 30px); line-height: 1.05; }
.etapa h3 small { display: block; font-family: var(--f-txt); font-size: 0.5em; letter-spacing: 0.12em; text-transform: uppercase; color: var(--giz-suave); margin-bottom: 2px; }
.etapa .perg { font-size: 0.85em; color: var(--giz-suave); margin: 0; }
.resp { margin-top: auto; font-family: var(--f-mao); font-size: clamp(20px, 1vw + 12px, 32px); line-height: 1.15; color: var(--verde-ok); min-height: 1.2em; overflow-wrap: anywhere; }
.resp table { border-collapse: collapse; font-family: var(--f-mao); margin-top: 2px; }
.resp td, .resp th { border: 2px solid var(--giz-suave); padding: 2px 10px; text-align: center; font-weight: 400; font-variant-numeric: tabular-nums; }
.resp th { color: var(--giz); font-size: 0.75em; }
.selo { font-size: 0.8em; font-weight: 700; color: var(--amarelo); }

/* ---------- controle da batata ---------- */
.controle { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 16px; align-items: stretch; }
@media (max-width: 900px) { .controle { grid-template-columns: 1fr; } }
.palco { background: var(--lousa-2); border-radius: 16px; padding: 14px 18px; display: flex; align-items: center; gap: 18px; min-height: 150px; }
.batata { width: clamp(80px, 8vw, 130px); flex: none; }
.batata.passando { animation: chacoalha .18s infinite alternate; }
@keyframes chacoalha { from { transform: rotate(-12deg) translateX(-4px); } to { transform: rotate(12deg) translateX(4px); } }
.status { min-width: 0; }
.status .grande { font-family: var(--f-mao); font-size: clamp(30px, 2.6vw + 12px, 64px); line-height: 1; }
.status .grande.parou { color: var(--amarelo); }
.status .sub { color: var(--giz-suave); font-size: 0.9em; margin-top: 6px; }
.acoes { display: flex; flex-direction: column; gap: 10px; justify-content: center; }
.linha-btn { display: flex; flex-wrap: wrap; gap: 10px; }
.btn { border: none; border-radius: 12px; padding: 12px 18px; font-weight: 700; font-size: 0.95em; color: var(--lousa); background: var(--giz); min-height: 48px; }
.btn:hover { filter: brightness(1.06); }
.btn.amarelo { background: var(--amarelo); }
.btn.ok { background: var(--verde-ok); }
.btn.ajuda { background: #cfe3f7; }
.btn.nao { background: var(--rosa); }
.btn.vazado { background: transparent; color: var(--giz); border: 2px solid var(--giz-suave); }
.btn[disabled] { opacity: .35; cursor: not-allowed; }
.dica { font-size: 0.8em; color: var(--giz-suave); margin: 0; }

/* ---------- navegação de questões ---------- */
.nav { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.nav span { font-size: 0.8em; color: var(--giz-suave); margin-right: 6px; }
.nav button { width: 42px; height: 42px; border-radius: 10px; border: 2px solid var(--lousa-3); background: var(--lousa-2); color: var(--giz); font-variant-numeric: tabular-nums; }
.nav button.feita { background: var(--lousa-3); color: var(--giz-suave); }
.nav button.atual { border-color: var(--amarelo); color: var(--amarelo); }
.nav .sep { width: 2px; height: 30px; background: var(--giz-suave); opacity: .4; margin: 0 6px; }

/* ---------- telas de início e fim ---------- */
.tela { max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; padding-block: 10px; }
.tela h1 { font-size: clamp(40px, 5vw + 10px, 92px); line-height: .95; }
.tela h1 span { color: var(--amarelo); }
.tela ol { margin: 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: 8px; }
.tela ol b { color: var(--amarelo); }
.config { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; background: var(--lousa-2); border-radius: 16px; padding: 16px; }
.config label { display: flex; flex-direction: column; gap: 6px; font-size: 0.85em; color: var(--giz-suave); }
.config select, .config input { font: inherit; color: var(--giz); background: var(--lousa); border: 2px solid var(--giz-suave); border-radius: 10px; padding: 8px 10px; min-height: 46px; }
.pontos { display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 0.9em; }
.pontos b { font-family: var(--f-mao); font-weight: 400; font-size: 1.3em; color: var(--amarelo); }
.final-num { font-family: var(--f-mao); font-size: clamp(60px, 8vw, 140px); line-height: 1; color: var(--amarelo); font-variant-numeric: tabular-nums; }

@media (prefers-reduced-motion: reduce) { .batata.passando { animation: none; } .barra i { transition: none; } }
</style>

<div class="wrap">

  <!-- ================= INÍCIO ================= -->
  <section class="tela" id="telaInicio">
    <h1>Batata quente da <span>regra de três</span></h1>
    <p style="margin:0;font-size:1.05em">Hoje a turma inteira joga junta para resolver problemas de química com regra de três. Cada problema tem 4 etapas, e cada etapa é respondida por uma pessoa diferente.</p>
    <h2 style="font-size:1.6em">Como jogar</h2>
    <ol>
      <li>Quando o tique-taque começar, passem a batata de mão em mão, sem segurar.</li>
      <li>Quando o jogo <b>apitar</b>, quem estiver com a batata responde a etapa <b>em voz alta</b>.</li>
      <li>Você pode pedir <b>ajuda a um colega</b>, mas quem responde é sempre você. O colega ajuda a pensar, não responde no seu lugar.</li>
      <li>Quem já respondeu neste problema não responde de novo: passe a batata para o colega do lado.</li>
    </ol>
    <h2 style="font-size:1.6em">As 4 etapas</h2>
    <ol>
      <li><b>Grandezas:</b> quais são as duas grandezas comparadas?</li>
      <li><b>Tabela:</b> o que vai na 1ª linha e o que vai na 2ª linha, com o x?</li>
      <li><b>Em cruz:</b> qual é a multiplicação em cruz e a conta que isola o x?</li>
      <li><b>Resposta:</b> qual é o resultado, com a unidade de medida?</li>
    </ol>
    <div class="linha-btn">
      <button class="btn amarelo" id="btnComecar" type="button">Começar o jogo</button>
    </div>
  </section>

  <!-- ================= JOGO ================= -->
  <section id="telaJogo" hidden>
    <div class="wrap">
      <header class="topo">
        <h1>Batata quente da <span>regra de três</span></h1>
        <div class="placar">
          <div class="estrelas">Resolvidos: <b id="pts">0</b> de <span id="tot">15</span></div>
          <div class="barra" aria-hidden="true"><i id="barra"></i></div>
          <button class="btn-peq" id="btnSom" type="button" aria-pressed="true">Som: ligado</button>
          <button class="btn-peq" id="btnFim" type="button">Encerrar</button>
        </div>
      </header>

      <div class="regra">Regra de ouro: <b>quem está com a batata responde.</b> O colega pode ajudar a pensar, mas não responde no seu lugar.</div>

      <article class="problema" aria-live="polite">
        <div class="num" id="qNum">1</div>
        <div class="enun">
          <span class="tag quim" id="qTag">Massa</span>
          <p id="qTxt"></p>
        </div>
      </article>

      <div class="etapas" id="etapas"></div>

      <div class="controle">
        <div class="palco">
          <svg class="batata" id="batata" viewBox="0 0 120 100" role="img" aria-label="Batata">
            <ellipse cx="60" cy="54" rx="52" ry="38" fill="#c79a5b"/>
            <ellipse cx="60" cy="50" rx="48" ry="33" fill="#d8ae6c"/>
            <circle cx="38" cy="44" r="3.5" fill="#8a6235"/>
            <circle cx="70" cy="36" r="3" fill="#8a6235"/>
            <circle cx="82" cy="60" r="3.5" fill="#8a6235"/>
            <circle cx="52" cy="66" r="2.5" fill="#8a6235"/>
            <path d="M42 22 q4 -10 10 -4 M60 18 q3 -10 9 -3 M76 22 q4 -9 9 -2" stroke="#f6d04d" stroke-width="3" fill="none" stroke-linecap="round"/>
          </svg>
          <div class="status">
            <div class="grande" id="stGrande">Pronto?</div>
            <div class="sub" id="stSub">Preparem a batata para a etapa 1.</div>
          </div>
        </div>
        <div class="acoes">
          <div class="linha-btn">
            <button class="btn amarelo" id="btnPassar" type="button">Passar a batata</button>
            <button class="btn vazado" id="btnParar" type="button" hidden>Parar agora</button>
            <button class="btn vazado" id="btnMostrar" type="button" disabled>Mostrar resposta</button>
          </div>
          <div class="linha-btn">
            <button class="btn ok" id="btnProx" type="button" disabled>Próxima etapa</button>
          </div>
        </div>
      </div>

      <nav class="nav" id="nav" aria-label="Escolher problema"></nav>
    </div>
  </section>

  <!-- ================= FIM ================= -->
  <section class="tela" id="telaFim" hidden>
    <h1 id="fimTitulo">Fim de jogo</h1>
    <div class="final-num" id="fimPts">0</div>
    <p style="margin:0" id="fimMsg"></p>
    <div class="linha-btn">
      <button class="btn amarelo" id="btnVoltar" type="button">Voltar ao jogo</button>
      <button class="btn vazado" id="btnNovo" type="button">Começar de novo</button>
    </div>
  </section>
</div>

<script>
(function () {
  // ---------- Problemas ----------
  // g: grandezas [col1, col2]; t: linhas da tabela; c: multiplicação em cruz; r: resposta
  const Q = [
    { tema: 'Massa', txt: 'A massa de 1 mol de gás oxigênio (O₂) é 32 g. Qual é a massa de 4 mol de O₂?',
      g: ['Quantidade (mol)', 'Massa (g)'], t: [['1', '32'], ['4', 'x']], c: '1 · x = 4 · 32 → x = 128', r: 'x = 128 g' },
    { tema: 'Massa', txt: 'A massa de 1 mol de cloreto de sódio (NaCl) é 58,5 g. Qual é a massa de 2 mol de NaCl?',
      g: ['Quantidade (mol)', 'Massa (g)'], t: [['1', '58,5'], ['2', 'x']], c: '1 · x = 2 · 58,5 → x = 117', r: 'x = 117 g' },
    { tema: 'Massa', txt: 'A massa de 1 mol de gás carbônico (CO₂) é 44 g. Qual é a massa de 0,5 mol de CO₂?',
      g: ['Quantidade (mol)', 'Massa (g)'], t: [['1', '44'], ['0,5', 'x']], c: '1 · x = 0,5 · 44 → x = 22', r: 'x = 22 g' },
    { tema: 'Massa', txt: 'A massa de 1 mol de hidróxido de sódio (NaOH) é 40 g. Quantos mol existem em 100 g de NaOH?',
      g: ['Quantidade (mol)', 'Massa (g)'], t: [['1', '40'], ['x', '100']], c: '40 · x = 1 · 100 → 40x = 100 → x = 100 ÷ 40', r: 'x = 2,5 mol' },
    { tema: 'Massa', txt: 'A massa de 1 mol de água (H₂O) é 18 g. Quantos mol de água existem em 90 g?',
      g: ['Quantidade (mol)', 'Massa (g)'], t: [['1', '18'], ['x', '90']], c: '18 · x = 1 · 90 → 18x = 90 → x = 90 ÷ 18', r: 'x = 5 mol' },
    { tema: 'Volume de gás', txt: 'Nas CNTP, 1 mol de qualquer gás ocupa 22,4 L. Qual é o volume ocupado por 3 mol de gás nitrogênio (N₂)?',
      g: ['Quantidade (mol)', 'Volume (L)'], t: [['1', '22,4'], ['3', 'x']], c: '1 · x = 3 · 22,4 → x = 67,2', r: 'x = 67,2 L' },
    { tema: 'Volume de gás', txt: 'Nas CNTP, 1 mol de qualquer gás ocupa 22,4 L. Qual é o volume ocupado por 0,5 mol de gás hidrogênio (H₂)?',
      g: ['Quantidade (mol)', 'Volume (L)'], t: [['1', '22,4'], ['0,5', 'x']], c: '1 · x = 0,5 · 22,4 → x = 11,2', r: 'x = 11,2 L' },
    { tema: 'Volume de gás', txt: 'Nas CNTP, 1 mol de qualquer gás ocupa 22,4 L. Quantos mol de CO₂ existem em 44,8 L desse gás?',
      g: ['Quantidade (mol)', 'Volume (L)'], t: [['1', '22,4'], ['x', '44,8']], c: '22,4 · x = 1 · 44,8 → x = 44,8 ÷ 22,4', r: 'x = 2 mol' },
    { tema: 'Moléculas', txt: 'Em 1 mol de água há 6,0 × 10²³ moléculas. Quantas moléculas existem em 3 mol de água?',
      g: ['Quantidade (mol)', 'Moléculas'], t: [['1', '6,0 × 10²³'], ['3', 'x']], c: '1 · x = 3 · 6,0 × 10²³ → x = 18 × 10²³', r: 'x = 1,8 × 10²⁴ moléculas' },
    { tema: 'Reação química', txt: 'Na reação 2 H₂ + O₂ → 2 H₂O, 1 mol de O₂ forma 2 mol de água. Quantos mol de água se formam com 5 mol de O₂?',
      g: ['O₂ (mol)', 'H₂O (mol)'], t: [['1', '2'], ['5', 'x']], c: '1 · x = 5 · 2 → x = 10', r: 'x = 10 mol de H₂O' },
    { tema: 'Reação química', txt: 'Na reação N₂ + 3 H₂ → 2 NH₃, 3 mol de H₂ formam 2 mol de NH₃. Quantos mol de NH₃ se formam com 12 mol de H₂?',
      g: ['H₂ (mol)', 'NH₃ (mol)'], t: [['3', '2'], ['12', 'x']], c: '3 · x = 12 · 2 → 3x = 24 → x = 24 ÷ 3', r: 'x = 8 mol de NH₃' },
    { tema: 'Reação química', txt: 'Na reação C + O₂ → CO₂, 12 g de carbono formam 44 g de CO₂. Quantos gramas de CO₂ se formam com 36 g de carbono?',
      g: ['Carbono (g)', 'CO₂ (g)'], t: [['12', '44'], ['36', 'x']], c: '12 · x = 36 · 44 → 12x = 1584 → x = 1584 ÷ 12', r: 'x = 132 g de CO₂' },
    { tema: 'Solução', txt: 'Uma solução tem 15 g de sal em cada 1 L. Quantos gramas de sal há em 0,4 L dessa solução?',
      g: ['Solução (L)', 'Sal (g)'], t: [['1', '15'], ['0,4', 'x']], c: '1 · x = 0,4 · 15 → x = 6', r: 'x = 6 g' },
    { tema: 'Solução', txt: 'Uma solução tem concentração de 20 g/L, ou seja, 20 g de soluto em cada 1 L. Quantos litros dessa solução contêm 50 g de soluto?',
      g: ['Solução (L)', 'Soluto (g)'], t: [['1', '20'], ['x', '50']], c: '20 · x = 1 · 50 → 20x = 50 → x = 50 ÷ 20', r: 'x = 2,5 L' },
    { tema: 'Pureza', txt: 'Uma amostra de minério tem 90% de pureza: em cada 100 g de amostra há 90 g da substância pura. Quantos gramas da substância pura há em 300 g de amostra?',
      g: ['Amostra (g)', 'Substância pura (g)'], t: [['100', '90'], ['300', 'x']], c: '100 · x = 300 · 90 → 100x = 27 000 → x = 27 000 ÷ 100', r: 'x = 270 g' },
  ];

  const ETAPAS = [
    { t: 'Grandezas', p: 'Quais são as duas grandezas que estão sendo comparadas?' },
    { t: 'Tabela', p: 'Monte a tabela: o que vai na 1ª linha e o que vai na 2ª, com o x?' },
    { t: 'Em cruz', p: 'Multiplique em cruz e diga a conta que isola o x.' },
    { t: 'Resposta', p: 'Qual é o resultado? Diga com a unidade de medida.' },
  ];

  // ---------- Estado ----------
  const S = { q: 0, etapa: 0, fase: 'pronto', feitas: {}, som: true, tela: 'inicio' };

  const $ = (id) => document.getElementById(id);
  const fmtTable = (q) => '<table><tr><th>' + q.g[0] + '</th><th>' + q.g[1] + '</th></tr>' +
    q.t.map((r) => '<tr><td>' + r[0] + '</td><td>' + r[1] + '</td></tr>').join('') + '</table>';
  const respostaEtapa = (q, i) => [q.g[0] + ' e ' + q.g[1], fmtTable(q), q.c, q.r][i];

  // ---------- Som ----------
  let ctx = null;
  function beep(freq, dur, vol, type) {
    if (!S.som) return;
    try {
      ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.type = type || 'square'; o.frequency.value = freq;
      g.gain.setValueAtTime(vol || 0.08, ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + dur);
      o.connect(g); g.connect(ctx.destination); o.start(); o.stop(ctx.currentTime + dur);
    } catch (e) { /* sem som */ }
  }
  function apito() { beep(880, 0.25, 0.15, 'sawtooth'); setTimeout(() => beep(660, 0.45, 0.15, 'sawtooth'), 220); }

  // ---------- Render ----------
  function render() {
    $('telaInicio').hidden = S.tela !== 'inicio';
    $('telaJogo').hidden = S.tela !== 'jogo';
    $('telaFim').hidden = S.tela !== 'fim';
    if (S.tela === 'fim') return renderFim();
    if (S.tela !== 'jogo') return;

    const q = Q[S.q];
    $('qNum').textContent = S.q + 1;
    $('qTag').textContent = q.tema;
    $('qTxt').textContent = q.txt;
    const nFeitas = Object.keys(S.feitas).length;
    $('pts').textContent = nFeitas;
    $('tot').textContent = Q.length;
    $('barra').style.width = (nFeitas / Q.length) * 100 + '%';
    $('btnSom').textContent = 'Som: ' + (S.som ? 'ligado' : 'desligado');
    $('btnSom').setAttribute('aria-pressed', String(S.som));

    $('etapas').innerHTML = ETAPAS.map((e, i) => {
      const cls = i === S.etapa && S.etapa < 4 ? 'atual' : (i > S.etapa ? 'futura' : '');
      const mostrada = i < S.etapa || (i === S.etapa && (S.fase === 'mostrou'));
      return '<div class="etapa ' + cls + '"><h3><small>Etapa ' + (i + 1) + '</small>' + e.t + '</h3>' +
        '<p class="perg">' + e.p + '</p>' +
        '<div class="resp">' + (mostrada ? respostaEtapa(q, i) : '') + '</div></div>';
    }).join('');

    const terminou = S.etapa >= 4;
    $('btnPassar').textContent = terminou ? 'Próximo problema' : 'Passar a batata';
    $('btnPassar').disabled = S.fase === 'passando' || (!terminou && S.fase !== 'pronto');
    $('btnParar').hidden = S.fase !== 'passando';
    $('btnMostrar').disabled = !(S.fase === 'parou');
    $('btnProx').disabled = S.fase !== 'mostrou';
    $('btnProx').textContent = S.etapa === 3 ? 'Concluir problema' : 'Próxima etapa';
    $('batata').classList.toggle('passando', S.fase === 'passando');

    const g = $('stGrande'), sub = $('stSub');
    g.classList.remove('parou');
    if (terminou) { g.textContent = 'Problema resolvido!'; sub.textContent = 'A turma fez as 4 etapas. Vamos para o próximo?'; }
    else if (S.fase === 'pronto') { g.textContent = 'Etapa ' + (S.etapa + 1) + ': ' + ETAPAS[S.etapa].t; sub.textContent = 'Preparem a batata! Quem respondeu neste problema passa para o colega do lado.'; }
    else if (S.fase === 'passando') { g.textContent = 'Passa, passa, passa…'; sub.textContent = 'O objeto não pode ficar parado na mão de ninguém.'; }
    else if (S.fase === 'parou') {
      g.classList.add('parou');
      g.textContent = 'PAROU!';
      sub.textContent = 'Quem está com a batata responde: ' + ETAPAS[S.etapa].p;
    } else if (S.fase === 'mostrou') { g.textContent = 'Confiram!'; sub.textContent = 'A resposta bateu com o que foi dito? Se não, quem estava com a batata explica de novo, agora com a resposta certa.'; }

    const nav = $('nav');
    nav.innerHTML = '<span>Problemas:</span>' + Q.map((x, i) =>
      '<button type="button" data-q="' + i + '" class="' + (i === S.q ? 'atual ' : '') + (S.feitas[i] ? 'feita' : '') +
      '" aria-label="Problema ' + (i + 1) + ', ' + x.tema + '">' + (i + 1) + '</button>').join('');
  }

  function renderFim() {
    const n = Object.keys(S.feitas).length;
    $('fimTitulo').textContent = 'Fim de jogo';
    $('fimPts').textContent = n + (n === 1 ? ' problema' : ' problemas');
    $('fimMsg').textContent = 'A turma resolveu ' + n + (n === 1 ? ' problema' : ' problemas') + ' de química com regra de três, e cada etapa foi respondida por uma pessoa diferente.';
  }

  // ---------- Ações ----------
  let timer = null, ticker = null;
  function pararBatata() {
    clearTimeout(timer); clearTimeout(ticker);
    S.fase = 'parou'; apito(); render();
  }
  function passar() {
    if (S.etapa >= 4) { proximo(); return; }
    S.fase = 'passando'; render();
    const total = 6000 + Math.random() * 9000, inicio = Date.now();
    (function tic() {
      const passado = Date.now() - inicio;
      beep(passado / total > 0.7 ? 1200 : 900, 0.05, 0.06, 'square');
      const gap = Math.max(110, 480 - (passado / total) * 380);
      ticker = setTimeout(tic, gap);
    })();
    timer = setTimeout(pararBatata, total);
  }
  function avancar() {
    beep(784, 0.15, 0.08, 'triangle');
    S.etapa++; S.fase = 'pronto';
    if (S.etapa >= 4) S.feitas[S.q] = true;
    render();
  }
  function irPara(i) { clearTimeout(timer); clearTimeout(ticker); S.q = i; S.etapa = S.feitas[i] ? 4 : 0; S.fase = 'pronto'; render(); }
  function proximo() {
    let n = S.q + 1; while (n < Q.length && S.feitas[n]) n++;
    if (n >= Q.length) { S.tela = 'fim'; render(); return; }
    irPara(n);
  }

  $('btnComecar').onclick = () => {
    S.tela = 'jogo'; S.fase = 'pronto'; beep(523, 0.12, 0.08, 'triangle'); render();
  };
  $('btnPassar').onclick = passar;
  $('btnParar').onclick = pararBatata;
  $('btnMostrar').onclick = () => { S.fase = 'mostrou'; render(); };
  $('btnProx').onclick = avancar;
  $('btnSom').onclick = () => { S.som = !S.som; render(); };
  $('btnFim').onclick = () => { clearTimeout(timer); clearTimeout(ticker); S.fase = 'pronto'; S.tela = 'fim'; render(); };
  $('btnVoltar').onclick = () => { S.tela = 'jogo'; render(); };
  $('btnNovo').onclick = () => {
    Object.assign(S, { q: 0, etapa: 0, fase: 'pronto', feitas: {}, tela: 'inicio' });
    render();
  };
  $('nav').addEventListener('click', (e) => { const b = e.target.closest('button[data-q]'); if (b) irPara(+b.dataset.q); });

  // mantém o jogo se a página for atualizada durante a aula
  function start(data) {
    if (data && data.S) { Object.assign(S, data.S); if (S.fase === 'passando') S.fase = 'pronto'; }
    render();
  }
  window.claude?.hot?.snapshot?.(() => ({ S }));
  window.claude?.hot?.ready ? window.claude.hot.ready(start) : start(window.claude?.hot?.data ?? {});
})();
</script>

</body></html>
